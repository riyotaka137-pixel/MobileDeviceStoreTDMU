<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#ECEFF1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Dòng đầu: Mã Voucher và Trạng thái -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvMaCodeVoucher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/primary_black"
                android:text="DISCOUNT20"
                android:textColor="@color/primary_yellow"
                android:textStyle="bold"
                android:textSize="14sp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvTrangThaiVoucher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đang áp dụng"
                android:textColor="#2E7D32"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Thông tin chi tiết mức giảm -->
        <TextView
            android:id="@+id/tvMucGiamVoucher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Giảm 20% (Tối đa: 100.000 đ)"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDieuKienVoucher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Đơn tối thiểu: 500.000 đ"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvHSDVoucher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Hạn sử dụng: 2026-12-31"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvMoTaVoucher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Mô tả voucher..."
            android:textColor="@color/text_hint"
            android:textSize="12sp" />

        <!-- Nút Sửa / Xóa -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnSuaVoucher"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="SỬA"
                android:textSize="12sp"
                android:textColor="@color/primary_black"
                android:backgroundTint="@color/primary_yellow"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnXoaVoucher"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="XÓA"
                android:textSize="12sp"
                android:textColor="@color/bg_white"
                android:backgroundTint="#D32F2F" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
