<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_card_modern"
    android:elevation="1dp"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgGioHang"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:scaleType="fitCenter"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTenSPGioHang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tên sản phẩm"
                android:textColor="#1C1C1C"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDonGiaGioHang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Đơn giá: 15.000.000 đ"
                android:textColor="#1C1C1C"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnGiamSoLuong"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="-"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#F2F2F7"
            android:textColor="#1C1C1C"
            android:padding="0dp" />

        <TextView
            android:id="@+id/tvSoLuongGioHang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:text="1"
            android:textColor="#1C1C1C"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTangSoLuong"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="+"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#F2F2F7"
            android:textColor="#1C1C1C"
            android:padding="0dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnXoaGioHang"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="XÓA"
            android:textColor="#D93025"
            android:background="#00000000"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
