<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/bg_white"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/stroke_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvTenNguoiDanhGia"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nguyễn Văn A"
                android:textColor="@color/primary_black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNgayDanhGia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-11-16"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

        <RatingBar
            android:id="@+id/rbItemDanhGia"
            style="?android:attr/ratingBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="1.0"
            android:rating="5"
            android:isIndicator="true"
            android:progressTint="@color/primary_yellow"
            android:secondaryProgressTint="@color/primary_yellow"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvNoiDungDanhGia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sản phẩm rất tốt, đóng gói cẩn thận, giao hàng nhanh chóng!"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
