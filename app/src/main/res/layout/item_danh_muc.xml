<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_marginEnd="16dp">

    <!-- Hộp chứa ảnh Danh Mục bo tròn hiện đại -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/stroke_light">

        <ImageView
            android:id="@+id/imgLogoDanhMuc"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/logo"
            android:contentDescription="Ảnh Danh Mục" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Tên Danh Mục nằm NẰM BÊN DƯỚI HỘP ẤNH -->
    <TextView
        android:id="@+id/tvTenDanhMuc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tên Danh Mục"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
