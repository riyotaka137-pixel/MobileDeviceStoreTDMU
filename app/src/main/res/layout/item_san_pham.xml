<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_margin="8dp"
    android:background="@drawable/bg_card_modern"
    android:elevation="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/imgSanPham"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:transitionName="product_img_trans"
            android:contentDescription="Hình sản phẩm" />

        <TextView
            android:id="@+id/tvBadgeGiamGia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#D93025"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="-10%"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true" />

    </RelativeLayout>

    <TextView
        android:id="@+id/tvThuongHieuSanPham"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="THƯƠNG HIỆU"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvTenSanPham"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tên sản phẩm"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvGiaGocSanPham"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="20.000.000 đ"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="2dp" />

    <TextView
        android:id="@+id/tvGiaSanPham"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="15.000.000 đ"
        android:textColor="@color/primary_black"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Dòng 1: Đánh giá sao & Đã bán -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/tvSaoSanPham"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="★ 0.0"
            android:textColor="#FFA000"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tvDaBanSanPham"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="• Đã bán 0"
            android:textColor="#666666"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Dòng 2: Tồn kho -->
    <TextView
        android:id="@+id/tvTonKhoSanPham"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tồn kho: 0"
        android:textColor="#2E7D32"
        android:textSize="11sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="2dp" />

    <!-- Nút Mua ngay (Chỉ hiển thị khi bật cờ showBuyNow ở Tab Khuyến mãi) -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnMuaNgaySanPham"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="8dp"
        android:text="Mua ngay"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:background="@drawable/bg_btn_buy_now"
        android:stateListAnimator="@null"
        android:elevation="0dp"
        android:padding="0dp"
        android:visibility="gone" />

</LinearLayout>
