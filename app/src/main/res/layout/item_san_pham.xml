<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_margin="8dp"
    android:background="@drawable/bg_card_modern"
    android:elevation="0dp">

    <ImageView
        android:id="@+id/imgSanPham"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:transitionName="product_img_trans"
        android:contentDescription="Hình sản phẩm"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvThuongHieuSanPham"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="THƯƠNG HIỆU"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvTenSanPham"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tên sản phẩm"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvGiaSanPham"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="15.000.000 đ"
        android:textColor="@color/primary_black"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
