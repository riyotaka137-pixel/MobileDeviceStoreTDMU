<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_modern">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTieuDeDialogSP"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="THÔNG TIN SẢN PHẨM"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/edtTenSPDialog"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Tên sản phẩm *"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary"
            android:inputType="textPersonName"
            android:background="@drawable/bg_edittext_modern"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Danh mục sản phẩm *"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spnDanhMucDialog"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_edittext_modern"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/edtGiaSPDialog"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Giá bán (VNĐ) *"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary"
            android:inputType="number"
            android:background="@drawable/bg_edittext_modern"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/edtSoLuongSPDialog"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Số lượng tồn kho *"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary"
            android:inputType="number"
            android:background="@drawable/bg_edittext_modern"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/edtThuongHieuSPDialog"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Thương hiệu"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary"
            android:inputType="text"
            android:background="@drawable/bg_edittext_modern"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hình ảnh sản phẩm"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <ImageView
            android:id="@+id/imgPreviewDialogSP"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_edittext_modern"
            android:padding="16dp"
            android:layout_marginBottom="12dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnChonAnhDialogSP"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="CHỌN ẢNH TỪ THƯ VIỆN"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_btn_secondary"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"
            android:elevation="0dp" />

        <EditText
            android:id="@+id/edtMoTaSPDialog"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Mô tả chi tiết sản phẩm"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:padding="20dp"
            android:background="@drawable/bg_edittext_modern"
            android:layout_marginBottom="32dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnHuyDialogSP"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="HỦY"
                android:background="@drawable/bg_btn_secondary"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:layout_marginEnd="12dp"
                android:elevation="0dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLuuDialogSP"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="LƯU"
                android:background="@drawable/bg_btn_primary"
                android:textColor="@color/text_on_yellow"
                android:textStyle="bold"
                android:elevation="2dp"
                android:stateListAnimator="@null" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
