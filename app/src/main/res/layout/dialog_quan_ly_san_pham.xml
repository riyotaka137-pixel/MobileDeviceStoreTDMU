<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTieuDeDialogSP"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="THÔNG TIN SẢN PHẨM"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1C1C1C"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/edtTenSPDialog"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Tên sản phẩm *"
            android:textColorHint="#8E8E93"
            android:textColor="#1C1C1C"
            android:inputType="textPersonName"
            android:background="@drawable/bg_edittext_modern"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Danh mục sản phẩm *"
            android:textColor="#1C1C1C"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spnDanhMucDialog"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_edittext_modern"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/edtGiaSPDialog"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Giá bán (VNĐ) *"
            android:textColorHint="#8E8E93"
            android:textColor="#1C1C1C"
            android:inputType="number"
            android:background="@drawable/bg_edittext_modern"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/edtSoLuongSPDialog"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Số lượng tồn kho *"
            android:textColorHint="#8E8E93"
            android:textColor="#1C1C1C"
            android:inputType="number"
            android:background="@drawable/bg_edittext_modern"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/edtThuongHieuSPDialog"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Thương hiệu (Apple, Samsung,...)"
            android:textColorHint="#8E8E93"
            android:textColor="#1C1C1C"
            android:inputType="text"
            android:background="@drawable/bg_edittext_modern"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hình ảnh sản phẩm"
            android:textColor="#1C1C1C"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <ImageView
            android:id="@+id/imgPreviewDialogSP"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_edittext_modern"
            android:padding="8dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnChonAnhDialogSP"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="CHỌN ẢNH TỪ THƯ VIỆN"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1A73E8"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/edtMoTaSPDialog"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:hint="Mô tả chi tiết sản phẩm"
            android:textColorHint="#8E8E93"
            android:textColor="#1C1C1C"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:padding="12dp"
            android:background="@drawable/bg_edittext_modern"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnHuyDialogSP"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="HỦY"
                android:backgroundTint="#8E8E93"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnLuuDialogSP"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="LƯU"
                android:backgroundTint="#111111"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
