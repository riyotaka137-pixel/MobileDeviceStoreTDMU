<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true"
    tools:context=".activity.DangNhapActivity">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/logo"
        android:scaleType="fitCenter"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvTieuDeDangNhap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ĐĂNG NHẬP"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#1C1C1C"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chào mừng bạn quay trở lại Mobile Store"
        android:textColor="#8E8E93"
        android:textSize="14sp"
        android:layout_marginBottom="28dp" />

    <EditText
        android:id="@+id/edtEmailDangNhap"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:hint="Nhập địa chỉ email..."
        android:textColorHint="#8E8E93"
        android:textColor="#1C1C1C"
        android:inputType="textEmailAddress"
        android:background="@drawable/bg_edittext_modern"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/edtMatKhauDangNhap"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:hint="Nhập mật khẩu..."
        android:textColorHint="#8E8E93"
        android:textColor="#1C1C1C"
        android:inputType="textPassword"
        android:background="@drawable/bg_edittext_modern"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="28dp" />

    <Button
        android:id="@+id/btnDangNhap"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="ĐĂNG NHẬP"
        android:textColor="#FFFFFF"
        android:backgroundTint="#111111"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/tvChuyenSangDangKy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chưa có tài khoản? Đăng ký ngay"
        android:textColor="#1A73E8"
        android:textSize="14sp"
        android:textStyle="bold"
        android:padding="8dp" />

</LinearLayout>
