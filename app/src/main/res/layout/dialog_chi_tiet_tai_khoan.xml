<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_card_modern">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CHI TIẾT TÀI KHOẢN"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvDialogMaTK"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mã tài khoản: #1"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvDialogHoTen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Họ tên: Nguyễn Văn A"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvDialogEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Email: nguyenvana@gmail.com"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvDialogSoDienThoai"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Số điện thoại: 0912345678"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvDialogDiaChi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Địa chỉ: Thủ Dầu Một, Bình Dương"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvDialogTrangThai"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Trạng thái: Hoạt động"
        android:textColor="#2E7D32"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDialogKhoaMoKhoa"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="KHÓA TÀI KHOẢN"
            android:background="@drawable/bg_btn_primary"
            android:textColor="@color/text_on_yellow"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:elevation="2dp"
            android:stateListAnimator="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDialogXoaTK"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="XÓA TÀI KHOẢN"
            android:background="@drawable/bg_btn_secondary"
            android:textColor="#D93025"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:elevation="0dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDialogDong"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="ĐÓNG"
            android:background="@drawable/bg_btn_secondary"
            android:textColor="@color/text_primary"
            android:elevation="0dp" />

    </LinearLayout>

</LinearLayout>
