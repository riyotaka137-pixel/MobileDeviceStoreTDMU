<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CHI TIẾT TÀI KHOẢN"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1C1C1C"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvDialogMaTK"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mã tài khoản: #1"
        android:textColor="#1C1C1C"
        android:textSize="15sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvDialogHoTen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Họ tên: Nguyễn Văn A"
        android:textColor="#1C1C1C"
        android:textSize="15sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvDialogEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Email: nguyenvana@gmail.com"
        android:textColor="#1C1C1C"
        android:textSize="15sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvDialogSoDienThoai"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Số điện thoại: 0912345678"
        android:textColor="#1C1C1C"
        android:textSize="15sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvDialogDiaChi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Địa chỉ: Thủ Dầu Một, Bình Dương"
        android:textColor="#1C1C1C"
        android:textSize="15sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvDialogTrangThai"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Trạng thái: Hoạt động"
        android:textColor="#2E7D32"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnDialogKhoaMoKhoa"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="KHÓA TÀI KHOẢN"
            android:backgroundTint="#F57C00"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnDialogXoaTK"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="XÓA TÀI KHOẢN"
            android:backgroundTint="#D93025"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnDialogDong"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="ĐÓNG"
            android:backgroundTint="#8E8E93"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</LinearLayout>
