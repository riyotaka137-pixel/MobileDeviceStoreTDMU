<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_modern">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUÉT MÃ VIETQR ĐỂ THANH TOÁN"
            android:textColor="@color/primary_black"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Ảnh mã VietQR động tải từ mạng -->
        <FrameLayout
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:background="@drawable/bg_edittext_modern"
            android:padding="8dp">

            <ImageView
                android:id="@+id/imgVietQR"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="Mã QR thanh toán VietQR" />
        </FrameLayout>

        <!-- Thông tin chuyển khoản -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F9FAFB"
            android:padding="14dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvVietQRMaDH"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mã đơn hàng: #1"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVietQRSoTien"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Số tiền: 0 đ"
                android:textColor="#D32F2F"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVietQRHuongDan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Ngân hàng: MB Bank\nSố tài khoản: 0987654321\nChủ tài khoản: TDMU MOBILE STORE\nNội dung: THANHTOAN_DH_1"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- Nút Xác nhận hoàn tất -->
        <Button
            android:id="@+id/btnVietQRXacNhan"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="TÔI ĐÃ CHUYỂN KHOẢN / HOÀN TẤT"
            android:textColor="@color/primary_black"
            android:backgroundTint="@color/primary_yellow"
            android:textStyle="bold"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>
