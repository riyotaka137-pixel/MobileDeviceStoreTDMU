<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light"
    android:fitsSystemWindows="true"
    tools:context=".activity.ThongTinCaNhanActivity">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_white"
        android:elevation="1dp"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBackHeader"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            app:tint="@color/text_primary"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="THÔNG TIN CÁ NHÂN"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/bg_card_modern"
            android:layout_margin="16dp"
            android:elevation="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/edtEmailCaNhan"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:enabled="false"
                android:background="@drawable/bg_edittext_modern"
                android:paddingHorizontal="20dp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Họ và tên *"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/edtHoTenCaNhan"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Nhập họ và tên..."
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:inputType="textPersonName"
                android:background="@drawable/bg_edittext_modern"
                android:paddingHorizontal="20dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Số điện thoại nhận hàng"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/edtSoDienThoaiCaNhan"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Nhập số điện thoại..."
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:inputType="phone"
                android:background="@drawable/bg_edittext_modern"
                android:paddingHorizontal="20dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Địa chỉ nhận hàng mặc định"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/edtDiaChiCaNhan"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:hint="Nhập địa chỉ nhận hàng..."
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:inputType="textMultiLine"
                android:gravity="top"
                android:padding="20dp"
                android:background="@drawable/bg_edittext_modern"
                android:layout_marginBottom="24dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCapNhatThongTin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="LƯU THÔNG TIN"
                android:background="@drawable/bg_btn_primary"
                android:textColor="@color/text_on_yellow"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"
                android:elevation="2dp"
                android:stateListAnimator="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMoDialogDoiMatKhau"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="ĐỔI MẬT KHẨU"
                android:background="@drawable/bg_btn_secondary"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="16sp"
                android:elevation="0dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
