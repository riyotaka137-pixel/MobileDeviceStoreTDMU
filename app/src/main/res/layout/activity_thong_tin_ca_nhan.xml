<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA"
    android:fitsSystemWindows="true"
    tools:context=".activity.ThongTinCaNhanActivity">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="1dp"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBackHeader"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="THÔNG TIN CÁ NHÂN"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1C1C1C" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#FFFFFF"
            android:layout_margin="16dp"
            android:elevation="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textColor="#8E8E93"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edtEmailCaNhan"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:enabled="false"
                android:background="#E0E0E0"
                android:paddingHorizontal="16dp"
                android:textColor="#8E8E93"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Họ và tên *"
                android:textColor="#1C1C1C"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edtHoTenCaNhan"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Nhập họ và tên..."
                android:textColorHint="#8E8E93"
                android:textColor="#1C1C1C"
                android:inputType="textPersonName"
                android:background="@drawable/bg_edittext_modern"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Số điện thoại nhận hàng"
                android:textColor="#1C1C1C"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edtSoDienThoaiCaNhan"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Nhập số điện thoại..."
                android:textColorHint="#8E8E93"
                android:textColor="#1C1C1C"
                android:inputType="phone"
                android:background="@drawable/bg_edittext_modern"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Địa chỉ nhận hàng mặc định"
                android:textColor="#1C1C1C"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edtDiaChiCaNhan"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:hint="Nhập địa chỉ nhận hàng..."
                android:textColorHint="#8E8E93"
                android:textColor="#1C1C1C"
                android:inputType="textMultiLine"
                android:gravity="top"
                android:padding="12dp"
                android:background="@drawable/bg_edittext_modern"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnCapNhatThongTin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="LƯU THÔNG TIN"
                android:backgroundTint="#111111"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnMoDialogDoiMatKhau"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="ĐỔI MẬT KHẨU"
                android:backgroundTint="#8E8E93"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
