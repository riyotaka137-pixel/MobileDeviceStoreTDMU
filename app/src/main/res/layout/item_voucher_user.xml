<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#212121"
    app:strokeWidth="1dp"
    app:strokeColor="@color/primary_yellow">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Dòng Header thẻ Voucher: Mã Code + Nút Sao chép -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvMaCodeVoucherUser"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SALE20"
                android:textColor="@color/primary_yellow"
                android:textSize="15sp"
                android:fontFamily="@font/nunito"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaoChepMa"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Sao chép"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/primary_black"
                app:backgroundTint="@color/primary_yellow"
                app:cornerRadius="17dp"
                android:paddingHorizontal="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>

        <!-- Mức giảm -->
        <TextView
            android:id="@+id/tvMucGiamVoucherUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Giảm 20%"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTienGiamToiDaUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Giảm tối đa: 100.000 đ"
            android:textColor="#B0BEC5"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvDonToiThieuUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Đơn tối thiểu: 500.000 đ"
            android:textColor="#B0BEC5"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvHSDVoucherUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="HSD: 2026-12-31"
            android:textColor="@color/primary_yellow"
            android:textSize="11sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
