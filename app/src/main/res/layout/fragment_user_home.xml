<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:elevation="1dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/logo"
            android:scaleType="fitCenter"
            android:contentDescription="Logo Store"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/tvXinChaoUser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Khách hàng"
            android:textColor="#1C1C1C"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnGioHangHeader"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="GIỎ HÀNG"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#111111"
            android:textStyle="bold"
            app:icon="@drawable/ic_gio_hang"
            app:iconTint="#FFFFFF"
            app:iconPadding="4dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Search box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <EditText
                    android:id="@+id/edtTimKiem"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:hint="Nhập tên sản phẩm cần tìm..."
                    android:textColorHint="#8E8E93"
                    android:textColor="#1C1C1C"
                    android:background="@drawable/bg_edittext_modern"
                    android:paddingHorizontal="18dp"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnTimKiem"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:text="TÌM"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#111111"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DANH MỤC SẢN PHẨM"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1C1C1C"
                android:layout_marginBottom="10dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDanhMuc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SẢN PHẨM NỔI BẬT"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1C1C1C"
                android:layout_marginBottom="10dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSanPham"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
