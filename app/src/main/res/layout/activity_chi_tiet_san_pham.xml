<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA"
    android:fitsSystemWindows="true"
    tools:context=".activity.ChiTietSanPhamActivity">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="1dp"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBackHeader"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:contentDescription="Quay lại"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CHI TIẾT SẢN PHẨM"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1C1C1C" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#FFFFFF"
            android:layout_margin="16dp"
            android:elevation="1dp">

            <ImageView
                android:id="@+id/imgChiTietSP"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:transitionName="product_img_trans"
                android:contentDescription="Ảnh chi tiết sản phẩm"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvThuongHieuChiTietSP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thương hiệu: Apple"
                android:textColor="#8E8E93"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvTenChiTietSP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tên Sản Phẩm"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#1C1C1C"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvGiaChiTietSP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="25.000.000 đ"
                android:textColor="#1C1C1C"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvKhoChiTietSP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Số lượng tồn kho: 10"
                android:textColor="#2E7D32"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F2F2F7"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MÔ TẢ SẢN PHẨM"
                android:textColor="#1C1C1C"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvMoTaChiTietSP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mô tả chi tiết sản phẩm..."
                android:textColor="#3A3A3C"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

    </ScrollView>

    <!-- Sticky Bottom Action Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:padding="16dp">

        <Button
            android:id="@+id/btnThemVaoGioHang"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="THÊM VÀO GIỎ HÀNG"
            android:backgroundTint="#111111"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
