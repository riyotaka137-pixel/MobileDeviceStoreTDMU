<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light"
    android:fitsSystemWindows="true"
    tools:context=".activity.ChiTietSanPhamActivity">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_white"
        android:elevation="1dp"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBackHeader"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            app:tint="@color/text_primary"
            android:contentDescription="Quay lại"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CHI TIẾT SẢN PHẨM"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/bg_card_modern"
            android:layout_margin="16dp"
            android:elevation="0dp">

            <ImageView
                android:id="@+id/imgChiTietSP"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:transitionName="product_img_trans"
                android:contentDescription="Ảnh chi tiết sản phẩm"
                android:layout_marginBottom="24dp" />

            <TextView
                android:id="@+id/tvThuongHieuChiTietSP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="THƯƠNG HIỆU"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvTenChiTietSP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tên Sản Phẩm"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvGiaChiTietSP"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="0 đ"
                    android:textColor="@color/primary_black"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/tvGiaGocChiTietSP"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="0 đ"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginEnd="10dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvBadgeChiTietSP"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_discount"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    tools:text="-15%"
                    android:visibility="gone" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvKhoChiTietSP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Đã bán: 0   |   Số lượng tồn kho: 0"
                android:textColor="#2E7D32"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/stroke_light"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MÔ TẢ SẢN PHẨM"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvMoTaChiTietSP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mô tả chi tiết sản phẩm..."
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:lineSpacingExtra="6dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/stroke_light"
                android:layout_marginVertical="20dp" />

            <!-- PHẦN ĐÁNH GIÁ SẢN PHẨM -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ĐÁNH GIÁ SẢN PHẨM"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Khung điểm trung bình & Nút viết đánh giá -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvDiemTrungBinhSao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_black"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <RatingBar
                        android:id="@+id/rbTrungBinhSao"
                        style="?android:attr/ratingBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:numStars="5"
                        android:stepSize="0.1"
                        android:rating="0"
                        android:isIndicator="true"
                        android:progressTint="@color/primary_yellow"
                        android:secondaryProgressTint="@color/primary_yellow"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tvSoLuotDanhGia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(Chưa có đánh giá)"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnVietDanhGia"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="VIẾT ĐÁNH GIÁ"
                    android:background="@drawable/bg_btn_primary"
                    android:textColor="@color/text_on_yellow"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="14dp"
                    android:visibility="gone" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvChuaCoDanhGia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sản phẩm chưa có đánh giá nào."
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:paddingVertical="16dp"
                android:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDanhSachDanhGia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

    <!-- Sticky Bottom Action Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_white"
        android:elevation="8dp"
        android:padding="20dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnThemVaoGioHang"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="THÊM VÀO GIỎ HÀNG"
            android:background="@drawable/bg_btn_primary"
            android:textColor="@color/text_on_yellow"
            android:textSize="16sp"
            android:textStyle="bold"
            android:elevation="2dp"
            android:stateListAnimator="@null" />

    </LinearLayout>

</LinearLayout>
