<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true"
    tools:context=".activity.DangKyActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/logo"
            android:scaleType="fitCenter"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvTieuDeDangKy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ĐĂNG KÝ TÀI KHOẢN"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1C1C1C"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tạo tài khoản mới để mua sắm trải nghiệm"
            android:textColor="#8E8E93"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/edtHoTenDangKy"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Họ và tên *"
            android:textColorHint="#8E8E93"
            android:textColor="#1C1C1C"
            android:inputType="textPersonName"
            android:background="@drawable/bg_edittext_modern"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/edtEmailDangKy"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Email *"
            android:textColorHint="#8E8E93"
            android:textColor="#1C1C1C"
            android:inputType="textEmailAddress"
            android:background="@drawable/bg_edittext_modern"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/edtMatKhauDangKy"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Mật khẩu *"
            android:textColorHint="#8E8E93"
            android:textColor="#1C1C1C"
            android:inputType="textPassword"
            android:background="@drawable/bg_edittext_modern"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/edtSoDienThoaiDangKy"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Số điện thoại"
            android:textColorHint="#8E8E93"
            android:textColor="#1C1C1C"
            android:inputType="phone"
            android:background="@drawable/bg_edittext_modern"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/edtDiaChiDangKy"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Địa chỉ giao hàng"
            android:textColorHint="#8E8E93"
            android:textColor="#1C1C1C"
            android:inputType="textPostalAddress"
            android:background="@drawable/bg_edittext_modern"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnDangKy"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="ĐĂNG KÝ"
            android:textColor="#FFFFFF"
            android:backgroundTint="#111111"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvChuyenSangDangNhap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đã có tài khoản? Đăng nhập ngay"
            android:textColor="#1A73E8"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="8dp" />

    </LinearLayout>

</ScrollView>
