<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_white"
    android:fitsSystemWindows="true"
    tools:context=".activity.DangKyActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/logo"
            android:scaleType="fitCenter"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvTieuDeDangKy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TẠO TÀI KHOẢN"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đăng ký để trải nghiệm mua sắm tuyệt vời"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="32dp" />

        <EditText
            android:id="@+id/edtHoTenDangKy"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Họ và tên *"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary"
            android:inputType="textPersonName"
            android:background="@drawable/bg_edittext_modern"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/edtEmailDangKy"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Email *"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary"
            android:inputType="textEmailAddress"
            android:background="@drawable/bg_edittext_modern"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/edtMatKhauDangKy"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Mật khẩu *"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary"
            android:inputType="textPassword"
            android:background="@drawable/bg_edittext_modern"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/edtSoDienThoaiDangKy"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Số điện thoại"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary"
            android:inputType="phone"
            android:background="@drawable/bg_edittext_modern"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/edtDiaChiDangKy"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Địa chỉ giao hàng"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary"
            android:inputType="textPostalAddress"
            android:background="@drawable/bg_edittext_modern"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="32dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDangKy"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="ĐĂNG KÝ"
            android:textColor="@color/text_on_yellow"
            android:background="@drawable/bg_btn_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            android:elevation="2dp"
            android:stateListAnimator="@null" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã có tài khoản? "
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvChuyenSangDangNhap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đăng nhập ngay"
                android:textColor="@color/primary_yellow"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="4dp" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
