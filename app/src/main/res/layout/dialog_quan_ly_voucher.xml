<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_modern">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvDialogTieuDeVoucher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="THÊM MÃ GIẢM GIÁ"
            android:textColor="@color/primary_black"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mã giảm giá (Code) *"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtDialogMaCode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_edittext_modern"
            android:hint="Ví dụ: SALE20"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:inputType="textCapCharacters"
            android:paddingHorizontal="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="% Giảm giá *"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtDialogPhanTramGiam"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_edittext_modern"
                    android:hint="1 - 100"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:inputType="number"
                    android:paddingHorizontal="14dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Giảm tối đa (đ)"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtDialogTienGiamToiDa"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_edittext_modern"
                    android:hint="Ví dụ: 100000"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:inputType="number"
                    android:paddingHorizontal="14dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đơn hàng tối thiểu (đ)"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtDialogDonToiThieu"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_edittext_modern"
            android:hint="0 nếu không yêu cầu"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:inputType="number"
            android:paddingHorizontal="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ngày hết hạn (YYYY-MM-DD)"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtDialogNgayHetHan"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_edittext_modern"
            android:hint="Ví dụ: 2026-12-31"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:paddingHorizontal="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mô tả voucher"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtDialogMoTa"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_edittext_modern"
            android:hint="Mô tả ngắn gọn điều kiện áp dụng"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:gravity="top|start"
            android:padding="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp" />

        <!-- Checkbox trạng thái kích hoạt -->
        <CheckBox
            android:id="@+id/cbDialogTrangThai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kích hoạt áp dụng mã này"
            android:checked="true"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnDialogHuyVoucher"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="HỦY"
                android:textColor="@color/text_secondary"
                android:backgroundTint="#ECEFF1"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnDialogLuuVoucher"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="LƯU"
                android:textColor="@color/primary_black"
                android:backgroundTint="@color/primary_yellow" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
