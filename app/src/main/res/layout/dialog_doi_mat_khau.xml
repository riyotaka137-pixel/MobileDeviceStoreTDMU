<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_card_modern">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ĐỔI MẬT KHẨU"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/edtMatKhauCu"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="Mật khẩu hiện tại"
        android:textColorHint="@color/text_hint"
        android:textColor="@color/text_primary"
        android:inputType="textPassword"
        android:background="@drawable/bg_edittext_modern"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/edtMatKhauMoi"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="Mật khẩu mới"
        android:textColorHint="@color/text_hint"
        android:textColor="@color/text_primary"
        android:inputType="textPassword"
        android:background="@drawable/bg_edittext_modern"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/edtXacNhanMatKhauMoi"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="Xác nhận mật khẩu mới"
        android:textColorHint="@color/text_hint"
        android:textColor="@color/text_primary"
        android:inputType="textPassword"
        android:background="@drawable/bg_edittext_modern"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="32dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnHuyDoiMatKhau"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:text="HỦY"
            android:background="@drawable/bg_btn_secondary"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginEnd="12dp"
            android:elevation="0dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLuuDoiMatKhau"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:text="LƯU"
            android:background="@drawable/bg_btn_primary"
            android:textColor="@color/text_on_yellow"
            android:textStyle="bold"
            android:elevation="2dp"
            android:stateListAnimator="@null" />

    </LinearLayout>

</LinearLayout>
