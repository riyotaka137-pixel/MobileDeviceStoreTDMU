<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ĐỔI MẬT KHẨU"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1C1C1C"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <EditText
        android:id="@+id/edtMatKhauCu"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Mật khẩu hiện tại"
        android:textColorHint="#8E8E93"
        android:textColor="#1C1C1C"
        android:inputType="textPassword"
        android:background="@drawable/bg_edittext_modern"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/edtMatKhauMoi"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Mật khẩu mới"
        android:textColorHint="#8E8E93"
        android:textColor="#1C1C1C"
        android:inputType="textPassword"
        android:background="@drawable/bg_edittext_modern"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/edtXacNhanMatKhauMoi"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Xác nhận mật khẩu mới"
        android:textColorHint="#8E8E93"
        android:textColor="#1C1C1C"
        android:inputType="textPassword"
        android:background="@drawable/bg_edittext_modern"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnHuyDoiMatKhau"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="HỦY"
            android:backgroundTint="#8E8E93"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnLuuDoiMatKhau"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="LƯU"
            android:backgroundTint="#111111"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
